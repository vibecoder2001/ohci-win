; OhciSpike.inx - UCX spike driver
[Version]
Signature    = "$Windows NT$"
Class        = USB
ClassGuid    = {36fc9e60-c465-11cf-8056-444553540000}
Provider     = %ProviderName%
CatalogFile  = OhciSpike.cat
DriverVer    = 01/01/2026,1.0.0.0
PnpLockdown  = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
OhciSpike.sys = 1

[Manufacturer]
%MfgName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%DeviceDesc% = OhciSpike_Device, PCI\VEN_106B&DEV_003F&CC_0C0310

[OhciSpike_Device.NT]
CopyFiles = OhciSpike_CopyFiles

[OhciSpike_CopyFiles]
OhciSpike.sys

[OhciSpike_Device.NT.Services]
AddService = OhciSpike, 0x00000002, OhciSpike_Service

[OhciSpike_Service]
DisplayName    = %ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\OhciSpike.sys

[Strings]
ProviderName = "ohci-win project"
MfgName      = "ohci-win"
DiskName     = "OhciSpike Installation Disk"
DeviceDesc   = "OHCI UCX Spike (NOT FOR PRODUCTION)"
ServiceDesc  = "OHCI UCX Spike"
